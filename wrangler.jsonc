{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krillion-tips",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{"binding":"CONTENT","database_name":"krillion-content","database_id":"ec658929-0743-44dc-8e61-6897d34ebcd8","migrations_dir":"migrations"}],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/krillion-answers-today*", "/krillion-hints*", "/krillion-archive*", "/when-does-krillion-reset*", "/sitemap.xml"]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "krillion.tips",
      "custom_domain": true
    },
    {
      "pattern": "www.krillion.tips",
      "custom_domain": true
    }
  ]
}
