{
  "name": "krillion-tips",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "check": "astro check",
    "deploy:sync": "wrangler deploy --config wrangler.sync.jsonc",
    "check:daily": "node --experimental-strip-types scripts/check-daily.ts",
    "content:export": "node --experimental-strip-types scripts/content.ts export",
    "content:publish-hints": "node --experimental-strip-types scripts/content.ts publish-hints",
    "verify": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.51.0"
  }
}
