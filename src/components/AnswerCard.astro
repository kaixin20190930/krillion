---
import TierPill from './TierPill.astro';
import { GENERIC_HINT, hintIsTailored } from '../lib/daily';
interface Answer { tier: string; answer: string; score: number; aliases?: string[] }
interface Prompt { text: string; hint: string; answers: Answer[] }
interface Props { prompt: Prompt; index: number; heading?: 'h2' | 'h3'; reveal?: boolean }
const { prompt, index, heading = 'h2', reveal = true } = Astro.props;
const Heading = heading;
---
<article class="card answer-card">
  <div class="answer-card__top">
    <span class="prompt-num">{index + 1}</span>
    <div><p class="card-kicker">Prompt {index + 1}</p><Heading>{prompt.text}</Heading></div>
    {reveal && prompt.answers.some(a => a.tier === 'krillion') && <TierPill tier="krillion" short />}
  </div>
  <p class="hint">{hintIsTailored(prompt.hint) ? prompt.hint : GENERIC_HINT}</p>
  {reveal ? (
    <div class="answer-row">
      {prompt.answers.map((answer) => (
        <div class="answer">
          <small>{answer.tier === 'krillion' ? 'Top pick' : answer.tier}</small>
          <strong>{answer.answer}</strong>
          <span class="points">{answer.score} points</span>
          {answer.aliases?.length ? <small>Also: {answer.aliases.join(', ')}</small> : null}
        </div>
      ))}
    </div>
  ) : <p class="hint"><a href="/krillion-answers-today/">Reveal today’s tiered answers</a></p>}
  {reveal && !prompt.answers.length && <p class="hint">Answer examples are being collected for this prompt.</p>}
</article>
