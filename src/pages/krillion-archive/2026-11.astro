---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { answerDays } from '../../data/answers';
const days = answerDays.filter((day) => day.date.startsWith('2026-11-'));
const title = 'Krillion Answers Archive – November 2026';
const description = 'November 2026 Krillion answers archive with daily prompts, hints, and verified scoring-tier examples.';
---
<BaseLayout {title} {description}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Archive',href:'/krillion-archive/'},{label:'November 2026'}]} />
  <section class="hero"><div class="shell"><p class="eyebrow">Monthly archive</p><h1>Krillion Answers – November 2026</h1><p class="lede">Verified daily dives published this month.</p></div></section>
  <section class="section"><div class="shell archive-list">{days.map((day)=><a class="card card-link archive-link" href={`/krillion-archive/${day.date}/`}><time datetime={day.date}>{day.displayDate}</time><div><h3>Dive #{day.dayNumber}</h3><p>{day.prompts.slice(0,2).map((prompt)=>prompt.text).join(' · ')}</p></div><strong>View answers</strong></a>)}</div></section>
</BaseLayout>
