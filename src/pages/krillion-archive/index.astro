---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { listDives, displayDate } from '../../lib/daily';
export const prerender = false;
const answerDays = await listDives(Astro.locals.runtime.env);
const title = 'Krillion Dive Archive';
const description = 'Browse the Krillion answers archive by date, with all seven prompts and representative answers for every scoring tier.';
---
<BaseLayout {title} {description}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Answer archive'}]} />
  <section class="hero"><div class="shell"><p class="eyebrow">Daily history</p><h1>Krillion Dive Archive</h1><p class="lede">Published dives only. Missing dates are not generated or filled with guesses.</p></div></section>
  <section class="section"><div class="shell archive-list">{answerDays.map((day)=><a class="card card-link archive-link" href={`/krillion-archive/${day.date}/`}><time datetime={day.date}>{displayDate(day.date)}</time><div><h3>Dive #{day.dive}</h3><p>{day.prompts.slice(0,2).map(p=>p.text).join(' · ')}</p></div><strong>{day.prompts.length} prompts</strong></a>)}</div></section>
</BaseLayout>
