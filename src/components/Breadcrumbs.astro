---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
};
---
<nav class="breadcrumb shell" aria-label="Breadcrumb">
  {items.map((item, index) => <><span>{index > 0 ? '/' : ''}</span>{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}</>)}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
